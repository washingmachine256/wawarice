{
    "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "output": "DP-1",  // Replace "eDP-1" with your main monitor's identifier
    "height": 30, // Waybar height
    // "width": 1280, // Waybar width
    // Choose the order of the modules
    "modules-left": ["niri/workspaces", "custom/weather"],
    "modules-center": ["niri/window"],
    "modules-right": ["tray", "pulseaudio", "custom/brightness", "cpu", "memory", "temperature", "clock"],
    // Modules configuration

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "●",
            "deactivated": "◌"
        },
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },
    "clock": {
        "tooltip-format": "{:%d-%m-%Y | %H:%M}",
        "format-alt": "{:%d-%m-%Y}"
    },
    "cpu": {
        "format": "{usage}% "
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C ",
        "format": "{temperatureC}°C "
    },
    "custom/brightness": { // uses ddcutil to change brightness of display 2
        // "format": "{"ddcutil -d 2 getvcp 10"}% {icon}",
        "format": "{icon}",
        "format-icons": ["", ""],
        "on-scroll-up": "ddcutil -d 2 setvcp 10 + 5",
        "on-scroll-down": "ddcutil -d 2 setvcp 10 - 10",
        "on-click-right": "ddcutil -d 2 setvcp 10 80",
        "on-click-left": "ddcutil -d 2 setvcp 10 60",
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        // "interface": "wlp2s0", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ",
        "format-ethernet": "{ifname} ",
        "format-disconnected": "Disconnected ⚠",
    },
    "pulseaudio": {
        "scroll-step": 1,
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "headphones": "",
            "handsfree": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": " ",
            "default": ["", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/weather": {
      "exec": "python3 ~/.config/waybar/scripts/weather.py",
      "restart-interval": 300,
      "return-type": "json",
      "on-click": "xdg-open https://weather.com/en-IN/weather/today/l/a319796a4173829988d68c4e3a5f90c1b6832667ea7aaa201757a1c887ec667a"
    },
    "niri/window": {
	    "format": "{}",
    	"rewrite": {
	    	"(.*) - Mozilla Firefox": "🌎 $1",
		    "(.*) - zsh": "> [$1]"
	    },
    },
    "niri/workspaces": {
        "format": "{icon}",
        "workspace-taskbar": {
            "enable": true,
            "icon-size": 18
        },
    },

}
